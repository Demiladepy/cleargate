# Copy to .env (never commit .env):
#   copy .env.example .env
#
# Safe defaults only — no secrets. Do not add private keys or real origin tokens here.

# Recording: use mainnet for full ERC-7730 USDT descriptor
CHAIN_ID=1
RPC_URL=https://ethereum-rpc.publicnode.com

# Ledger transport: speculos (emulator) | hid (physical Nano USB)
TRANSPORT=speculos
SPECULOS_URL=http://127.0.0.1:5000
SPECULOS_CONTROLLER_URL=http://127.0.0.1:5000
SPECULOS_MODEL=nanox

# Speculos: 0 = click approve in browser (recommended for recording)
AUTO_APPROVE=0

# Signing
DERIVATION_PATH=44'/60'/0'/0/0
LEDGER_ORIGIN_TOKEN=

RECIPIENT=0x70997970C51812dc3A010C7d01b50e0d17dc79C8
ATTACKER=0x3C44CdDdB6a900fa2b585dd299e03d12FA4293BC
